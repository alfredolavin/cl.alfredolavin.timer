<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <!-- Color entries are configurable colors: a plain color ("#rrggbb", "#aarrggbb" or "r,g,b[,a]") or JSON
         {src: fixed|begin|end|current, color, l, c, a} taking it from the active gradient; see contents/ui/code/colorspec.js -->

    <group name="Appearance">
        <entry name="cornerRadius" type="Int"><default>6</default></entry>
        <!-- frame background and outline (also the buttons' borders); empty = derived from the older entries below -->
        <entry name="frameBackgroundColor" type="String"><default></default></entry>
        <entry name="frameOutlineColor" type="String"><default></default></entry>
        <entry name="borderWidth" type="Int"><default>2</default></entry>
        <entry name="padding" type="Int"><default>2</default></entry>
        <entry name="spacing" type="Int"><default>4</default></entry>
        <!-- older frame settings, no longer shown: read only while the two entries above are empty
             (see legacyFrame in contents/ui/code/colorspec.js) -->
        <entry name="borderColor" type="String"><default>#3daee9</default></entry>
        <entry name="backgroundTransparency" type="Int"><default>30</default></entry>
        <entry name="linkColors" type="Bool"><default>false</default></entry>
        <entry name="linkedBgOpacity" type="Int"><default>60</default></entry>
        <entry name="linkedBgLuminosity" type="Int"><default>-50</default></entry>
        <entry name="linkedBgChroma" type="Int"><default>0</default></entry>
        <entry name="linkedOutlineOpacity" type="Int"><default>100</default></entry>
        <entry name="linkedOutlineLuminosity" type="Int"><default>20</default></entry>
        <entry name="linkedOutlineChroma" type="Int"><default>0</default></entry>
        <entry name="iconSize" type="Int"><default>32</default></entry>
        <entry name="useThemeIconColor" type="Bool"><default>true</default></entry>
        <entry name="iconColor" type="String"><default>#ffffff</default></entry>
        <entry name="nameFontSize" type="Int"><default>9</default></entry>
        <entry name="barWidth" type="Int"><default>100</default></entry>
        <entry name="barHeightPercent" type="Int"><default>60</default></entry>
        <entry name="barRadius" type="Int"><default>4</default></entry>
        <entry name="timeFontSize" type="Int"><default>0</default></entry>
        <entry name="textShadow" type="Bool"><default>true</default></entry>
        <entry name="buttonIconSize" type="Int"><default>27</default></entry>
        <entry name="buttonBorderWidth" type="Int"><default>1</default></entry>
        <entry name="buttonRadius" type="Int"><default>4</default></entry>
        <!-- color of the "time is up" text drawn over the progress bar -->
        <entry name="finishedTextColor" type="String"><default>#ff0000</default></entry>
    </group>

    <group name="ProgressBar">
        <entry name="trackColor" type="String"><default>#5a000000</default></entry>
        <entry name="barBorderColor" type="String"><default>#59ffffff</default></entry>
        <entry name="barBorderWidth" type="Int"><default>1</default></entry>
        <!-- JSON array of {enabled, x, y, blur, spread, color, inset} -->
        <entry name="barShadows" type="String"><default>[{"enabled":true,"x":0,"y":1,"blur":3,"spread":0,"color":"#80000000","inset":false},{"enabled":true,"x":0,"y":1,"blur":2,"spread":0,"color":"#73000000","inset":true}]</default></entry>
        <entry name="glowEnabled" type="Bool"><default>true</default></entry>
        <entry name="glowUseGradient" type="Bool"><default>true</default></entry>
        <entry name="glowColor" type="String"><default>#3daee9</default></entry>
        <entry name="glowRadius" type="Int"><default>6</default></entry>
        <entry name="glowStrength" type="Int"><default>1</default></entry>
        <entry name="glowOpacity" type="Int"><default>70</default></entry>
        <!-- text inside the bar: bundled Rubik at this weight (300-900), filled and outlined -->
        <entry name="barFontWeight" type="Int"><default>800</default></entry>
        <entry name="barTextColor" type="String"><default>#ffffff</default></entry>
        <entry name="barTextOutlineColor" type="String"><default>#000000</default></entry>
        <entry name="barTextOutlineWidth" type="Int"><default>1</default></entry>
    </group>

    <group name="Timers">
        <!-- JSON array of timer definitions; empty means built-in defaults -->
        <entry name="timers" type="String"><default></default></entry>
        <!-- gradient of one-off timers and alarms from the popup's quick entry; empty = the first gradient -->
        <entry name="quickGradient" type="String"><default></default></entry>
        <!-- CSS gradients; empty means built-in defaults -->
        <entry name="gradientsCss" type="String"><default></default></entry>
        <!-- visibility mode of the hosting panel while it is forced visible by a finished timer; -1 = not forced -->
        <entry name="savedPanelVisibility" type="Int"><default>-1</default></entry>
        <!-- JSON array of running timers, survives restarts -->
        <entry name="runningState" type="String"><default>[]</default></entry>
    </group>
</kcfg>
